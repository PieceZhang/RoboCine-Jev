<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="jvs_orange"><color rgba="0.95 0.35 0.05 1.0"/></material>
  <material name="jvs_dark"><color rgba="0.08 0.09 0.11 1.0"/></material>
  <material name="jvs_gray"><color rgba="0.42 0.45 0.48 1.0"/></material>
  <material name="jvs_blue"><color rgba="0.08 0.32 0.72 1.0"/></material>
  <material name="jvs_camera"><color rgba="0.04 0.04 0.05 1.0"/></material>

  <!-- Most links use primitives; the tapered base uses one local convex STL. -->
  <xacro:macro name="frustum_body"
    params="bottom_radius top_radius length mass origin_z mesh_filename material">
    <!-- Exact centroid and principal inertias for a uniform solid conical frustum. -->
    <xacro:property name="frustum_s"
      value="${bottom_radius * bottom_radius + bottom_radius * top_radius + top_radius * top_radius}"/>
    <xacro:property name="frustum_q"
      value="${bottom_radius**4 + bottom_radius**3 * top_radius + bottom_radius**2 * top_radius**2 + bottom_radius * top_radius**3 + top_radius**4}"/>
    <xacro:property name="frustum_u_bar"
      value="${(bottom_radius**2 + 2.0 * bottom_radius * top_radius + 3.0 * top_radius**2) / (4.0 * frustum_s)}"/>
    <xacro:property name="frustum_u2"
      value="${(bottom_radius**2 + 3.0 * bottom_radius * top_radius + 6.0 * top_radius**2) / (10.0 * frustum_s)}"/>
    <inertial>
      <origin xyz="0 0 ${origin_z - length / 2.0 + length * frustum_u_bar}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * frustum_q / (20.0 * frustum_s) + length**2 * (frustum_u2 - frustum_u_bar**2))}"
        ixy="0" ixz="0"
        iyy="${mass * (3.0 * frustum_q / (20.0 * frustum_s) + length**2 * (frustum_u2 - frustum_u_bar**2))}"
        iyz="0" izz="${mass * 3.0 * frustum_q / (10.0 * frustum_s)}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${origin_z}" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_filename}"/></geometry>
      <material name="${material}"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${origin_z}" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_filename}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="cylinder_body" params="radius length mass origin_xyz origin_rpy material">
    <inertial>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}" iyz="0"
        izz="${mass * radius * radius / 2.0}"/>
    </inertial>
    <visual>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      <material name="${material}"/>
    </visual>
    <collision>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="box_body" params="size_x size_y size_z mass origin_xyz origin_rpy material">
    <inertial>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (size_y * size_y + size_z * size_z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (size_x * size_x + size_z * size_z) / 12.0}" iyz="0"
        izz="${mass * (size_x * size_x + size_y * size_y) / 12.0}"/>
    </inertial>
    <visual>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry>
      <material name="${material}"/>
    </visual>
    <collision>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <geometry><box size="${size_x} ${size_y} ${size_z}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="sphere_body" params="radius mass material">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${0.4 * mass * radius * radius}" ixy="0" ixz="0"
               iyy="${0.4 * mass * radius * radius}" iyz="0"
               izz="${0.4 * mass * radius * radius}"/>
    </inertial>
    <visual>
      <geometry><sphere radius="${radius}"/></geometry>
      <material name="${material}"/>
    </visual>
    <collision><geometry><sphere radius="${radius}"/></geometry></collision>
  </xacro:macro>
</robot>
