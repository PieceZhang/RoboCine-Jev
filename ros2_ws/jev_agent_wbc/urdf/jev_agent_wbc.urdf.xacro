<?xml version="1.0"?>
<robot name="jev_agent_wbc" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="package_root" value="${xacro.abs_filename('..')}" lazy_eval="false"/>
  <xacro:arg name="controllers_file" default="${package_root}/config/jarvis_controllers.yaml"/>
  <xacro:arg name="sim_backend" default="gazebo"/>
  <xacro:arg name="lidar_mode" default="both"/>
  <xacro:property name="arm_mass_scale" value="0.6"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_top_radius" value="0.13"/>
  <xacro:property name="base_bottom_radius" value="0.18"/>
  <xacro:include filename="${package_root}/urdf/materials.xacro"/>
  <xacro:include filename="${package_root}/urdf/ros2_control.xacro"/>
  <xacro:include filename="${package_root}/urdf/gazebo.xacro"/>

  <!-- Base origin is on the ground plane. The top keeps the target 0.13 m
       radius, while the wider lower edge overlaps all three caster posts. -->
  <link name="base_link">
    <xacro:frustum_body bottom_radius="${base_bottom_radius}"
      top_radius="${base_top_radius}" length="${base_height}" mass="31.772322"
      origin_z="0.13" mesh_filename="${package_root}/meshes/base_frustum.stl"
      material="jvs_orange"/>
  </link>

  <link name="left_wheel_link">
    <xacro:cylinder_body radius="0.07" length="0.04" mass="0.35"
      origin_xyz="0 0 0" origin_rpy="1.57079632679 0 0" material="jvs_dark"/>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/>
    <origin xyz="0 0.105 0.070" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="20.0" velocity="15.0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <link name="right_wheel_link">
    <xacro:cylinder_body radius="0.07" length="0.04" mass="0.35"
      origin_xyz="0 0 0" origin_rpy="1.57079632679 0 0" material="jvs_dark"/>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/>
    <origin xyz="0 -0.105 0.070" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="20.0" velocity="15.0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <!-- One front-centre and two rear passive casters match the target support
       footprint. Their swivel and rolling joints are unactuated in both
       simulators; the wheel contact remains deliberately low-friction. -->
  <xacro:macro name="passive_caster" params="name x y">
    <link name="${name}_swivel_link">
      <xacro:cylinder_body radius="0.022" length="0.06" mass="0.04"
        origin_xyz="0 0 0.01" origin_rpy="0 0 0" material="jvs_gray"/>
    </link>
    <joint name="${name}_swivel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_swivel_link"/>
      <origin xyz="${x} ${y} 0.055" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="0.2" velocity="20.0"/>
      <dynamics damping="0.01" friction="0.002"/>
    </joint>
    <link name="${name}_wheel_link">
      <xacro:cylinder_body radius="0.02" length="0.018" mass="0.08"
        origin_xyz="0 0 0" origin_rpy="1.57079632679 0 0" material="jvs_dark"/>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${name}_swivel_link"/><child link="${name}_wheel_link"/>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="0.2" velocity="50.0"/>
      <dynamics damping="0.002" friction="0.001"/>
    </joint>
    <xacro:if value="${'$(arg sim_backend)' == 'gazebo'}">
      <gazebo reference="${name}_wheel_link">
        <mu1>0.02</mu1><mu2>0.02</mu2>
      </gazebo>
    </xacro:if>
  </xacro:macro>
  <xacro:passive_caster name="front_caster" x="0.180" y="0"/>
  <xacro:passive_caster name="rear_left_caster" x="-0.131" y="0.089"/>
  <xacro:passive_caster name="rear_right_caster" x="-0.131" y="-0.089"/>

  <!-- Bridge the chassis top (0.19) to the unchanged neck origin (0.266). -->
  <link name="arm_pedestal_link">
    <xacro:box_body size_x="0.080" size_y="0.080" size_z="0.076" mass="0.35"
      origin_xyz="0 0 0" origin_rpy="0 0 0" material="jvs_gray"/>
  </link>
  <joint name="arm_pedestal_joint" type="fixed">
    <parent link="base_link"/><child link="arm_pedestal_link"/>
    <origin xyz="0.098 0 0.228" rpy="0 0 0"/>
  </joint>

  <!-- Support the body camera without changing its calibrated frame. -->
  <link name="rgbd_mount_link">
    <xacro:box_body size_x="0.072" size_y="0.040" size_z="0.026" mass="0.06"
      origin_xyz="0 0 0" origin_rpy="0 0 0" material="jvs_gray"/>
  </link>
  <joint name="rgbd_mount_joint" type="fixed">
    <parent link="base_link"/><child link="rgbd_mount_link"/>
    <origin xyz="0.156 0 0.125" rpy="0 0 0"/>
  </joint>

  <!-- Level near-field LiDAR on the rear of the chassis top. This keeps the
       sensor clear of the front RGBD camera and arm pedestal while the wide
       vertical profile covers both the floor near field and arm-height
       obstacles. Keep the extrinsic in TF for both simulator backends. -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- The local STL is authored in millimetres. -->
        <mesh filename="${package_root}/meshes/jarvis_lidar.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="jvs_dark"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="-0.085 0 0.235" rpy="0 0 0"/>
  </joint>

  <!-- Restore the original front sensor extrinsic; keep the rear TF/topic
       unchanged for existing consumers. Both sensors have distinct frames. -->
  <link name="front_lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${package_root}/meshes/jarvis_lidar.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="jvs_dark"/>
    </visual>
  </link>
  <joint name="front_lidar_joint" type="fixed">
    <parent link="base_link"/><child link="front_lidar_link"/>
    <origin xyz="0.190 0 0.274" rpy="0 0.898844565 0"/>
  </joint>

  <!-- Neck mounting and six revolute joints. Joint rpy values are all zero. -->
  <link name="neck_base_link">
    <xacro:cylinder_body radius="0.04" length="0.07" mass="${0.30 * arm_mass_scale}"
      origin_xyz="0 0 0.035" origin_rpy="0 0 0" material="jvs_gray"/>
  </link>
  <joint name="neck_base_joint" type="fixed">
    <parent link="base_link"/><child link="neck_base_link"/>
    <origin xyz="0.098 0 0.266" rpy="0 0 0"/>
  </joint>

  <link name="link1">
    <xacro:cylinder_body radius="0.027" length="0.10" mass="${0.28 * arm_mass_scale}"
      origin_xyz="0 0 0.05" origin_rpy="0 0 0" material="jvs_blue"/>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="neck_base_link"/><child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.3962634016" upper="1.3962634016" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.15" friction="0.02"/>
  </joint>

  <link name="link2">
    <xacro:cylinder_body radius="0.025" length="0.205218" mass="${0.35 * arm_mass_scale}"
      origin_xyz="0 0.00975 0.102145" origin_rpy="0 0.0952 1.57079632679" material="jvs_blue"/>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.18682389136" upper="0.698131700798" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.15" friction="0.02"/>
  </joint>

  <link name="link3">
    <xacro:cylinder_body radius="0.024" length="0.188000" mass="${0.32 * arm_mass_scale}"
      origin_xyz="-0.041 -0.010 0.084" origin_rpy="0 0.465 -2.902" material="jvs_blue"/>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0.0195 0.20429" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-0.523598775598" upper="2.61799387799" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.15" friction="0.02"/>
  </joint>

  <link name="link4">
    <xacro:cylinder_body radius="0.023" length="0.094340" mass="${0.24 * arm_mass_scale}"
      origin_xyz="0 0.017 0.044" origin_rpy="0 0.369 1.57079632679" material="jvs_blue"/>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="-0.082 -0.020 0.168" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="8.0" velocity="1.2"/>
    <dynamics damping="0.12" friction="0.02"/>
  </joint>

  <link name="link5">
    <xacro:cylinder_body radius="0.021" length="0.084528" mass="${0.50 * arm_mass_scale}"
      origin_xyz="0.034 -0.0175 0.018" origin_rpy="0 1.130847 -0.475343" material="jvs_blue"/>
  </link>
  <joint name="joint5" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0 0.034 0.088" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.61799387799" upper="0.03490658504" effort="8.0" velocity="1.2"/>
    <dynamics damping="0.12" friction="0.02"/>
  </joint>

  <link name="link6">
    <xacro:cylinder_body radius="0.020" length="0.122540" mass="${0.18 * arm_mass_scale}"
      origin_xyz="0.019 0 0.05825" origin_rpy="0 0.315 0" material="jvs_blue"/>
  </link>
  <joint name="joint6" type="revolute">
    <parent link="link5"/><child link="link6"/>
    <origin xyz="0.068 -0.035 0.036" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.698131700798" upper="0.698131700798" effort="6.0" velocity="1.5"/>
    <dynamics damping="0.10" friction="0.01"/>
  </joint>

  <!-- Head camera and REP-103 optical frame (z forward, x right, y down). -->
  <link name="camera_link">
    <xacro:box_body size_x="0.060" size_y="0.080" size_z="0.050" mass="0.12"
      origin_xyz="0 0 0" origin_rpy="0 0 0" material="jvs_camera"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="link6"/><child link="camera_link"/>
    <origin xyz="0.038 0 0.1165" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin xyz="0.02 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- Independent body-mounted RGBD camera. -->
  <link name="rgbd_link">
    <xacro:box_body size_x="0.055" size_y="0.090" size_z="0.040" mass="0.14"
      origin_xyz="0 0 0" origin_rpy="0 0 0" material="jvs_camera"/>
  </link>
  <joint name="rgbd_joint_fixed" type="fixed">
    <parent link="base_link"/><child link="rgbd_link"/>
    <origin xyz="0.207 0 0.125" rpy="0 -0.118464 0"/>
  </joint>
  <link name="rgbd_optical_frame"/>
  <joint name="rgbd_optical_joint" type="fixed">
    <parent link="rgbd_link"/><child link="rgbd_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- Simulator plugins are deliberately excluded from the Isaac description.
       Isaac imports the common kinematic/dynamic model and supplies its own
       PhysX articulation plus ROS 2 bridge in scripts/jvs_isaac_sim.py. -->
  <xacro:if value="${'$(arg sim_backend)' == 'gazebo'}">
    <xacro:jvs_ros2_control/>
    <xacro:jvs_gazebo controllers_file="$(arg controllers_file)"/>
  </xacro:if>
</robot>
