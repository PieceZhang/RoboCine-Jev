<?xml version="1.0"?>
<package format="3">
  <name>jev_agent_wbc</name><version>0.2.0</version>
  <description>Independent Jev cinematic dynamic whole-body controller and evaluation</description>
  <maintainer email="robocine@example.com">RoboCine</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-scipy</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>std_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend><exec_depend>xacro</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
